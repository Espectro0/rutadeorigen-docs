<mxfile host="Electron" pages="5">
  <diagram name="RegistrarLote" id="ZMsMUlmr3khu9GQLDAJY">
    <mxGraphModel dx="6148" dy="3657" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;---\ntitle: Registrar lote - paso por las capas del backend\n---\nsequenceDiagram\n  autonumber\n  participant F as Front\n  participant C as Controller&lt;br&gt;infrastructure/input\n  participant A as Adapter&lt;br&gt;application/input\n  participant UC as UseCase&lt;br&gt;application/usecases\n  participant D as Dominio&lt;br&gt;domain\n  participant R as Repositorios + Outbox&lt;br&gt;infrastructure/output\n  participant RL as OutboxRelay&lt;br&gt;infrastructure/output\n  participant MQ as RabbitMQ\n  participant Q as QR Service&lt;br&gt;handler, adapter, usecase\n\n  Note over F,C: Login OIDC con WorkOS, POST /me y POST /farms siguen el mismo recorrido de capas\n  F-&gt;&gt;C: POST /api/lots (cookie de sesión)\n  C-&gt;&gt;C: RequireActor resuelve el actor\n  C-&gt;&gt;A: Execute(request.CreateLot)\n  A-&gt;&gt;A: Assembler: DTO a borrador de Lot\n  A-&gt;&gt;UC: Execute(borrador)\n  UC-&gt;&gt;R: ActorActive y FarmExists (puertos de salida)\n  R--&gt;&gt;UC: actor y finca\n  UC-&gt;&gt;UC: Authorizer: acción create_lot\n  UC-&gt;&gt;D: lot.New(finca, código, variedad, proceso, cosecha)\n  D--&gt;&gt;UC: lote válido en etapa finca\n  UC-&gt;&gt;R: ExistsByCode\n  Note over UC,R: TxManager.WithinTx: una sola transacción\n  UC-&gt;&gt;R: Save lot\n  UC-&gt;&gt;R: Publish lot.created (fila en outbox)\n  UC--&gt;&gt;A: Lot\n  A--&gt;&gt;C: DTO de respuesta\n  C--&gt;&gt;F: 201 lote\n  opt validación, permiso o código repetido\n    UC--&gt;&gt;C: exception tipada (por Adapter)\n    C--&gt;&gt;F: ErrorResponder: 400 / 403 / 404 / 409\n  end\n  RL-&gt;&gt;R: Leer outbox pendiente (SKIP LOCKED)\n  RL-&gt;&gt;MQ: lot.created\n  RL-&gt;&gt;R: Marcar published_at\n  MQ-&gt;&gt;Q: lot.created\n  Q-&gt;&gt;Q: Handler, Adapter, ProjectLotCreated\n  Q-&gt;&gt;Q: Inbox processed_event y guardar lot_view&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="WkWPlI8hQp3y7-wtKyV8-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
