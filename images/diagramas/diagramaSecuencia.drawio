  <diagram id="4bDpntDcQzk5bENicGNP" name="ConsultarQR">
    <mxGraphModel dx="2438" dy="281" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;---\ntitle: Consultar QR - paso por las capas del servicio QR\n---\nsequenceDiagram\n  autonumber\n  actor C as Consumidor\n  participant TR as Traefik\n  participant F as Front\n  participant K as Controller&lt;br&gt;infrastructure/input\n  participant A as Adapter&lt;br&gt;application/input\n  participant UC as UseCase&lt;br&gt;application/usecases\n  participant D as Dominio&lt;br&gt;redirect, scan, lotview\n  participant RD as Redis&lt;br&gt;LotViewCache\n  participant DB as Repositorios&lt;br&gt;Postgres\n\n  C-&gt;&gt;TR: Escanea el QR (/l/:lot_id)\n  TR-&gt;&gt;K: GET /l/:lot_id\n  K-&gt;&gt;A: Execute(request.ResolveScan)\n  A-&gt;&gt;UC: Execute(path)\n  UC-&gt;&gt;DB: RedirectRepository.ListActive\n  UC-&gt;&gt;D: rule.Matches y rule.Resolve(path)\n  D--&gt;&gt;UC: Resolution con lot_id\n  UC-&gt;&gt;RD: LotViewExists: buscar en caché\n  alt cache miss\n    UC-&gt;&gt;DB: LotViewRepository.FindByID\n    UC-&gt;&gt;RD: Guardar en caché\n  end\n  UC-&gt;&gt;DB: ScanRepository.Save (qr_scan, sin bloquear)\n  UC--&gt;&gt;A: Resolution\n  A--&gt;&gt;K: DTO ScanRedirect\n  K--&gt;&gt;TR: 301 Location (no-store)\n  TR--&gt;&gt;C: Redirección\n  C-&gt;&gt;F: Abrir página del lote\n  F-&gt;&gt;TR: GET /api/public/lots/:lot_id\n  TR-&gt;&gt;K: GET /public/lots/:lot_id (sin /api)\n  K-&gt;&gt;A: Execute(request.GetPublicLot)\n  A-&gt;&gt;UC: Execute(lot_id)\n  UC-&gt;&gt;RD: LotViewExists: buscar en caché\n  alt cache hit\n    RD--&gt;&gt;UC: LotView\n  else cache miss\n    UC-&gt;&gt;DB: LotViewRepository.FindByID\n    DB--&gt;&gt;UC: LotView\n    UC-&gt;&gt;RD: Guardar en caché\n  end\n  UC--&gt;&gt;A: LotView\n  A-&gt;&gt;A: lotviewmapper: LotView a DTO\n  A--&gt;&gt;K: PublicLot\n  K--&gt;&gt;F: 200 JSON del lote\n  F--&gt;&gt;C: Mostrar trazabilidad&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="2xvjPBzZoxHyapJ0tBZV-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
