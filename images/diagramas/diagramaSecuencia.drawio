  <diagram id="9o5xGT-bLbCq2jYVgZyW" name="SubirEvidencia">
    <mxGraphModel dx="2438" dy="1450" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;---\ntitle: Subir evidencia - capas de traceability (por construir)\n---\nsequenceDiagram\n  autonumber\n  participant F as Front\n  participant C as Controller&lt;br&gt;infrastructure/input\n  participant A as Adapter&lt;br&gt;application/input\n  participant UC as UseCase&lt;br&gt;application/usecases\n  participant D as Dominio&lt;br&gt;domain/evidence\n  participant G as Garage&lt;br&gt;infrastructure/output/external\n  participant R as Repositorios + Outbox&lt;br&gt;infrastructure/output\n  participant RL as OutboxRelay&lt;br&gt;infrastructure/output\n  participant MQ as RabbitMQ\n\n  F-&gt;&gt;C: POST /api/lots/:id/evidences (imagen)\n  C-&gt;&gt;C: RequireActor y límite de tamaño\n  C-&gt;&gt;A: Execute(request.UploadEvidence)\n  A-&gt;&gt;A: Assembler: DTO a Command\n  A-&gt;&gt;UC: Execute(Command)\n  UC-&gt;&gt;R: ActorActive y LotExists\n  R--&gt;&gt;UC: actor y lote\n  UC-&gt;&gt;UC: Authorizer: acción upload_evidence\n  UC-&gt;&gt;D: evidence.New en estado pending (solo imágenes)\n  D--&gt;&gt;UC: evidencia válida\n  UC-&gt;&gt;G: PUT en evidence-quarantine (puerto de almacenamiento)\n  Note over UC,R: TxManager.WithinTx: una sola transacción\n  UC-&gt;&gt;R: Save evidence pending\n  UC-&gt;&gt;R: Publish evidence.uploaded (outbox, con email de quien sube)\n  UC--&gt;&gt;A: Result\n  A--&gt;&gt;C: DTO de respuesta\n  C--&gt;&gt;F: 202 Accepted\n  RL-&gt;&gt;R: Leer outbox pendiente\n  RL-&gt;&gt;MQ: evidence.uploaded\n  Note over MQ: Cola processor.events&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="7C-Ej-fG39lqlyFuyDWv-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
